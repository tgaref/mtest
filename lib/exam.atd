type answer = { ans     : string;
                correct : bool;
              }

type question = { group     : string;
                  statement : string;
		  answers   : answer list;
		} <ocaml field_prefix = "exam_q_">

type exam = { name      : string;
              footer    : string;
              questions : question list;
	    } <ocaml field_prefix = "exam_e_">


type groupProfile = {name      : string;
                     num       : int;
		     saveSpace : bool;
		    } <ocaml field_prefix="prof_g_">

type examProfile = { totalNum  : int;
                     seed      : string;
                     profile   : groupProfile list;
		   } <ocaml field_prefix="prof_e_">


type groupMarks = { name    : string;
                    negmark : float;
		    posmark : float;
		  } <ocaml field_prefix="prof_mark_g_">

type markProfile = groupMarks list


type testPaper = {serial    : int;
                  questions : question list;
		 } <ocaml field_prefix="paper_">


type testPapers = testPaper list

type correctAns = { serial  : string;
                    answers : (string * string) list;
                  } <ocaml field_prefix="corr_">

type correctAnsList = correctAns list
